                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 45\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete item (owner)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/items/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "items",
                "1"
              ]
            }
          }
        }
      ]
    },
